    <mxCell id="c_154" value="ONE-TIME SETUP (per identity) — Create Postgres Role" style="swimlane;html=1;startSize=32;fillColor=#FFF5F5;strokeColor=#D32F2F;strokeWidth=2;fontStyle=1;fontSize=14;fontFamily=Inter,Helvetica,Arial;fontColor=#B71C1C;rounded=1;arcSize=8;swimlaneLine=0;shadow=0;" vertex="1" parent="1">
      <mxGeometry x="20" y="748" width="1420" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="155" value="SELECT databricks_create_role('&lt;identity&gt;', 'end_user' | 'service_principal');
GRANT CONNECT ON DATABASE databricks_postgres TO &quot;&lt;identity&gt;&quot;;
GRANT USAGE ON SCHEMA public TO &quot;&lt;identity&gt;&quot;;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO &quot;&lt;identity&gt;&quot;;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=1.5;fontFamily=Inter,Helvetica,Arial;fontSize=11;fontColor=#212121;shadow=0;verticalAlign=middle;fontFamily=Courier New;fontSize=10;align=left;" vertex="1" parent="c_154">
      <mxGeometry x="15" y="30" width="680" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n_156" value="Required BEFORE any identity can use generate_database_credential.
Human users: use 'end_user'. Service Principals: use 'service_principal'.
Run this SQL once per identity using an admin credential.
See docs/AUTHENTICATION.md for full SQL." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFEBEE;strokeColor=#C62828;shadow=0;fontFamily=Inter,Helvetica,Arial;fontSize=10;fontColor=#455A64;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;spacingRight=4;" vertex="1" parent="c_154">
