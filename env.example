# Copy this file to .env and fill in your values for local development.
# Never commit .env to git.

# Lakebase connection
LAKEBASE_HOST=ep-xxxxx.database.us-east-1.cloud.databricks.com
LAKEBASE_USER=your-email@company.com
LAKEBASE_DB=databricks_postgres
LAKEBASE_PORT=5432

# Unity Catalog
UC_CATALOG=your_catalog
UC_SCHEMA=lakebase_credit_demo

# MLflow model
MODEL_NAME=credit_scoring_v1
N_ROWS=100000

# Databricks workspace (injected automatically in Apps/Jobs runtime)
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Lakebase endpoint path (for generate_database_credential)
# Get from: Catalog Explorer → Lakebase → your instance
LAKEBASE_ENDPOINT_PATH=projects/lakebase-credit-demo/branches/production/endpoints/primary
